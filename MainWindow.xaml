<Window x:Class="TestReporter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TestReporter" Height="800" Width="1200">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Файл">
                <MenuItem Header="Выход" Click="MenuExit_Click"/>
            </MenuItem>
            <MenuItem Header="Справка">
                <MenuItem Header="О программе" Click="MenuAbout_Click"/>
            </MenuItem>
        </Menu>

        <ToolBar DockPanel.Dock="Top" Margin="4">
            <Button x:Name="btnImportFiles" Content="Добавить файлы тестирований" Click="OnImportFilesClick" Margin="2"/>
            <Button x:Name="btnSelectFolder" Content="Выбрать папку" Click="OnSelectFolderClick" Margin="2"/>
            <Button x:Name="btnColumnMap" Content="Сопоставление столбцов" Click="OnOpenColumnMapping" Margin="8,2"/>
            <Separator/>
            <ComboBox x:Name="cbAggregation" Width="140" Margin="4">
                <ComboBoxItem Content="Сумма" IsSelected="True"/>
                <ComboBoxItem Content="Среднее"/>
            </ComboBox>
            <Separator/>
            <Button x:Name="btnGenerate" Content="Сформировать отчет по группам" Click="OnGenerateReportClick" Margin="4" IsEnabled="False"/>
            <Button x:Name="btnNewReport" Content="Создать новый отчет" Click="OnCreateNewReportClick" Margin="4" IsEnabled="False"/>
            <Button x:Name="btnUpdateReport" Content="Обновить существующий отчет..." Click="OnUpdateReportClick" Margin="4" IsEnabled="False"/>
            <Button x:Name="btnExportPdf" Content="Экспорт в PDF" Click="OnExportPdfClick" Margin="4" IsEnabled="False"/>
            <Button x:Name="btnPrint" Content="Печать" Click="OnPrintClick" Margin="4" IsEnabled="False"/>
        </ToolBar>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="txtStatus" Text="Готов" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <ProgressBar x:Name="mainProgress" Width="300" Height="16" Minimum="0" Maximum="100" Value="0"/>
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Files -->
            <GroupBox Header="Загрузка файлов" Grid.Column="0" Margin="6">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6" HorizontalAlignment="Left">
                        <TextBlock VerticalAlignment="Center" Margin="4">Поддерживаемые: .xlsx, .xls, .csv</TextBlock>
                    </StackPanel>
                    <DataGrid x:Name="dgLoadedFiles" AutoGenerateColumns="False" Margin="6" IsReadOnly="True" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Имя (Тема)" Binding="{Binding FileName}" Width="*" />
                            <DataGridTextColumn Header="Формат" Binding="{Binding Format}" Width="80" />
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="140" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="6">
                        <Button Content="Разрешить конфликты" Click="OnResolveNameConflictsClick" Margin="2"/>
                    </StackPanel>
                </DockPanel>
            </GroupBox>

            <!-- Center: Preview -->
            <GroupBox Header="Предпросмотр" Grid.Column="1" Margin="6">
                <DockPanel>
                    <TabControl x:Name="tabPreview" Margin="6">
                        <TabItem Header="Детальный">
                            <DataGrid x:Name="dgPreviewDetail" AutoGenerateColumns="True" IsReadOnly="True"/>
                        </TabItem>
                        <TabItem Header="Матричный (агрегация)">
                            <DataGrid x:Name="dgPreviewMatrix" AutoGenerateColumns="True" IsReadOnly="True"/>
                        </TabItem>
                        <TabItem Header="Статистика по вопросам">
                            <DataGrid x:Name="dgQuestionStats" AutoGenerateColumns="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Тема" Binding="{Binding Topic}" Width="200"/>
                                    <DataGridTextColumn Header="Вопрос" Binding="{Binding Question}" Width="*"/>
                                    <DataGridTextColumn Header="Правильных" Binding="{Binding CorrectCount}" Width="120"/>
                                    <DataGridTextColumn Header="Всего" Binding="{Binding TotalCount}" Width="120"/>
                                    <DataGridTextColumn Header="% правильных" Binding="{Binding Percent, StringFormat=N2}" Width="120"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </GroupBox>

            <!-- Right: Filters and Reports -->
            <StackPanel Grid.Column="2" Margin="6" Orientation="Vertical">
                <GroupBox Header="Фильтры" Margin="0,0,0,8">
                    <StackPanel Margin="6">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock VerticalAlignment="Center" Text="Дата с:" Margin="0,0,6,0"/>
                            <DatePicker x:Name="dpFrom" Width="140" IsEnabled="False"/>
                            <TextBlock VerticalAlignment="Center" Text="По:" Margin="12,0,6,0"/>
                            <DatePicker x:Name="dpTo" Width="140" IsEnabled="False"/>
                        </StackPanel>

                        <TextBlock FontWeight="Bold" Margin="0,6,0,2">Темы</TextBlock>
                        <ScrollViewer Height="100">
                            <ItemsControl x:Name="icTopics" />
                        </ScrollViewer>

                        <TextBlock FontWeight="Bold" Margin="0,6,0,2">Группы</TextBlock>
                        <ScrollViewer Height="100">
                            <ItemsControl x:Name="icGroups" />
                        </ScrollViewer>

                        <TextBlock FontWeight="Bold" Margin="0,6,0,2">Студенты</TextBlock>
                        <ScrollViewer Height="100">
                            <ItemsControl x:Name="icStudents" />
                        </ScrollViewer>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Button x:Name="btnApplyFilters" Content="Применить фильтры" Click="OnApplyFiltersClick" IsEnabled="False"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Управление отчетами">
                    <StackPanel Margin="6">
                        <Button Content="Сформировать отчет по группам" Click="OnGenerateReportClick" Margin="0,4" IsEnabled="False"/>
                        <Button Content="Создать новый отчет" Click="OnCreateNewReportClick" Margin="0,4" IsEnabled="False"/>
                        <Button Content="Обновить существующий отчет..." Click="OnUpdateReportClick" Margin="0,4" IsEnabled="False"/>
                        <Separator Margin="0,6"/>
                        <Button Content="Экспорт в PDF" Click="OnExportPdfClick" Margin="0,4" IsEnabled="False"/>
                        <Button Content="Печать" Click="OnPrintClick" Margin="0,4" IsEnabled="False"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
