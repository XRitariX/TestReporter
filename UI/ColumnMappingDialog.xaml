<Window x:Class="TestReporter.ColumnMappingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сопоставление столбцов" Height="520" Width="900" WindowStartupLocation="CenterOwner">
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <!-- Слева: обнаруженные заголовки -->
        <GroupBox Header="Обнаруженные заголовки" Grid.Column="0" Margin="6">
            <ListBox x:Name="lbDetectedHeaders" Margin="6" SelectionMode="Extended"/>
        </GroupBox>

        <!-- Справа: назначение ролей -->
        <GroupBox Header="Назначение ролей" Grid.Column="1" Margin="6">
            <StackPanel Margin="6">
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock VerticalAlignment="Center" Width="110">ФИО (обязательно):</TextBlock>
                    <ComboBox x:Name="cbNameColumn" Width="300"/>
                </StackPanel>

n                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock VerticalAlignment="Center" Width="110">Группа (опц.):</TextBlock>
                    <ComboBox x:Name="cbGroupColumn" Width="300"/>
                </StackPanel>

n                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock VerticalAlignment="Center" Width="110">Дата (опц.):</TextBlock>
                    <ComboBox x:Name="cbDateColumn" Width="300"/>
                </StackPanel>

n                <TextBlock FontWeight="Bold" Margin="0,8,0,4">Столбцы с вопросами (чекбоксы)</TextBlock>
                <ScrollViewer Height="220">
                    <ItemsControl x:Name="icQuestionColumns">
                        <!-- каждый элемент: CheckBox с именем столбца -->
                    </ItemsControl>
                </ScrollViewer>

n                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button Content="Сохранить настройки как шаблон" Click="OnSaveTemplateClick" Margin="4"/>
                    <Button Content="Применить" Click="OnApplyMappingClick" Margin="4"/>
                    <Button Content="Отмена" Click="OnCancelMappingClick" Margin="4"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>
    </Grid>
</Window>